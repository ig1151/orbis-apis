{
  "name": "Meeting Invite Parser API",
  "slug": "meeting-invite-parser",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 500
    },
    "pay_per_call": {
      "parse": "$0.003",
      "extract": "$0.002",
      "execution-gate": "$0.001",
      "meeting-intelligence": "$0.006"
    }
  },
  "rate_limits": {
    "free": "500/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "parse",
    "extract",
    "execution-gate",
    "meeting-intelligence"
  ],
  "execution_chain": {
    "recommended_start": "/meeting-intelligence",
    "fallback": "/parse",
    "batch_endpoint": "/parse"
  }
}
