{
  "openapi": "3.1.0",
  "info": {
    "title": "Receipt Parser API",
    "version": "2.0.0",
    "description": "Extract merchant details, line items, taxes, and totals from receipts for expense management and accounting agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 300
      },
      "pay_per_call": {
        "parse": "$0.005",
        "categorize": "$0.003",
        "summarize": "$0.003",
        "execution-gate": "$0.001",
        "receipt-intelligence": "$0.010",
        "split": "$0.003",
        "batch": "$0.040"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/receipt-parser"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/parse": {
      "post": {
        "operationId": "parseReceipt",
        "summary": "Parse receipt \u2014 merchant, items, taxes, totals, payment method",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/categorize": {
      "post": {
        "operationId": "categorizeReceipt",
        "summary": "Categorize receipt expenses \u2014 food, travel, office, etc.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/summarize": {
      "post": {
        "operationId": "summarizeReceipt",
        "summary": "Summarize receipt for expense reports",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/receipt-intelligence": {
      "post": {
        "operationId": "receiptIntelligence",
        "summary": "ONE-CALL: parse + categorize + tax extraction + expense policy check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/split": {
      "post": {
        "operationId": "splitReceipt",
        "summary": "Split receipt for shared expenses",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "participants": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchParse",
        "summary": "Batch parse up to 20 receipts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "documents": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 20
                  }
                },
                "required": [
                  "documents"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}