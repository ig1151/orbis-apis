{
  "openapi": "3.1.0",
  "info": {
    "title": "FAQ Schema Validator API",
    "version": "2.0.0",
    "description": "Validate FAQ schema markup for Google rich result eligibility with confidence scoring and provenance metadata."
  },
  "servers": [{ "url": "https://orbis-apis.onrender.com/faq-schema-validator" }],
  "security": [{ "ApiKeyAuth": [] }],
  "paths": {
    "/validate": {
      "post": {
        "operationId": "validateFaqSchema",
        "summary": "Validate FAQ schema from URL or raw JSON",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FaqValidateInput" },
              "example": { "url": "https://example.com/faq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "FAQ schema validation result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FaqSchemaResponse" },
                "example": {
                  "success": true,
                  "request_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "data": {
                    "source": "https://example.com/faq",
                    "faq_count": 5,
                    "is_valid": true,
                    "questions": [
                      { "question": "What is SEO?", "answer": "SEO stands for Search Engine Optimization.", "question_length": 11, "answer_length": 38, "valid": true, "issues": [] },
                      { "question": "How long does SEO take?", "answer": "SEO results typically take 3-6 months.", "question_length": 23, "answer_length": 38, "valid": true, "issues": [] }
                    ],
                    "errors": [],
                    "google_eligible": true,
                    "character_limits_ok": true
                  },
                  "confidence": { "score": 0.96, "reason": "Full FAQPage schema parse and validation", "per_section": { "validity": 0.98, "google": 0.94 } },
                  "provenance": { "provider": "faq-schema-validator", "retrieved_at": "2026-05-18T12:00:00Z", "source_type": "live_scan" },
                  "cache": { "recommended_ttl_seconds": 86400, "retryable": true, "cache_recommended": true },
                  "recommended_next_api": [{ "api": "schema-org-extractor", "endpoint": "/validate", "reason": "Cross-validate FAQPage with full schema extraction" }],
                  "recommended_actions_priority_order": [{ "priority": "low", "action": "Add 2 more FAQ questions for richer SERP display", "reason": "Google displays up to 10 FAQ items" }],
                  "execution_metadata": { "latency_ms": 510, "model": "faq-validate-v2", "automation_safe": true }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/check": {
      "post": {
        "operationId": "checkFaqSchema",
        "summary": "Rapid FAQ schema presence check on any URL",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UrlInput" },
              "example": { "url": "https://example.com/about" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "FAQ schema check result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FaqCheckResponse" },
                "example": {
                  "success": true,
                  "request_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
                  "data": {
                    "url": "https://example.com/about",
                    "has_faq_schema": false,
                    "schema_format": "none",
                    "question_count": 0,
                    "is_eligible": false
                  },
                  "confidence": { "score": 0.99, "reason": "Direct DOM schema check", "per_section": {} },
                  "provenance": { "provider": "faq-schema-validator", "retrieved_at": "2026-05-18T12:01:00Z", "source_type": "live_scan" },
                  "cache": { "recommended_ttl_seconds": 86400, "retryable": true, "cache_recommended": true },
                  "recommended_next_api": [{ "api": "schema-org-extractor", "endpoint": "/extract", "reason": "Check for other schema types on this page" }],
                  "recommended_actions_priority_order": [{ "priority": "medium", "action": "Add FAQ schema to this page", "reason": "FAQ rich results can increase CTR by 20-30%" }],
                  "execution_metadata": { "latency_ms": 280, "model": "faq-check-v2", "automation_safe": true }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGateFaqSchema",
        "summary": "Signal whether FAQ schema quality meets automated optimization standards",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UrlInput" },
              "example": { "url": "https://example.com/faq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution gate result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExecutionGateResponse" },
                "example": {
                  "success": true,
                  "request_id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
                  "execution_ready": true,
                  "next_api": "breadcrumb-validator",
                  "next_endpoint": "/validate",
                  "blocking_flags": [],
                  "confidence": { "score": 0.97, "reason": "Valid eligible FAQ schema present", "per_section": {} },
                  "provenance": { "provider": "faq-schema-validator", "retrieved_at": "2026-05-18T12:02:00Z", "source_type": "live_scan" },
                  "execution_metadata": { "latency_ms": 220, "model": "gate-v2", "automation_safe": true }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/faq-schema-intelligence": {
      "post": {
        "operationId": "faqSchemaIntelligence",
        "summary": "Full intelligence summary of FAQ schema with provenance and priority actions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FaqValidateInput" },
              "example": { "url": "https://example.com/faq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "FAQ schema intelligence report",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FaqSchemaResponse" },
                "example": {
                  "success": true,
                  "request_id": "d4e5f6a7-b8c9-0123-defa-234567890123",
                  "data": {
                    "source": "https://example.com/faq",
                    "faq_count": 8,
                    "is_valid": true,
                    "questions": [],
                    "errors": [],
                    "google_eligible": true,
                    "character_limits_ok": true
                  },
                  "confidence": { "score": 0.95, "reason": "Comprehensive FAQ intelligence analysis", "per_section": { "validity": 0.97, "google": 0.93 } },
                  "provenance": { "provider": "faq-schema-validator", "retrieved_at": "2026-05-18T12:03:00Z", "source_type": "live_scan" },
                  "cache": { "recommended_ttl_seconds": 86400, "retryable": true, "cache_recommended": true },
                  "recommended_next_api": [{ "api": "featured-snippet-predictor", "endpoint": "/predict", "reason": "Assess snippet potential for FAQ answers" }],
                  "recommended_actions_priority_order": [{ "priority": "low", "action": "Ensure all answers are at least 50 characters", "reason": "Google prefers detailed answers in FAQ schema" }],
                  "execution_metadata": { "latency_ms": 680, "model": "intelligence-v2", "automation_safe": true }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-API-Key" }
    },
    "schemas": {
      "UrlInput": {
        "type": "object",
        "required": ["url"],
        "properties": { "url": { "type": "string", "format": "uri" } }
      },
      "FaqValidateInput": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "schema_json": { "type": "object" }
        }
      },
      "FaqQuestion": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "question_length": { "type": "integer" },
          "answer_length": { "type": "integer" },
          "valid": { "type": "boolean" },
          "issues": { "type": "array", "items": { "type": "string" } }
        }
      },
      "FaqSchemaData": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "faq_count": { "type": "integer" },
          "is_valid": { "type": "boolean" },
          "questions": { "type": "array", "items": { "$ref": "#/components/schemas/FaqQuestion" } },
          "errors": { "type": "array", "items": { "type": "string" } },
          "google_eligible": { "type": "boolean" },
          "character_limits_ok": { "type": "boolean" }
        }
      },
      "FaqCheckData": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "has_faq_schema": { "type": "boolean" },
          "schema_format": { "type": "string", "enum": ["json-ld", "microdata", "none"] },
          "question_count": { "type": "integer" },
          "is_eligible": { "type": "boolean" }
        }
      },
      "Confidence": {
        "type": "object",
        "properties": {
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string" },
          "per_section": { "type": "object", "additionalProperties": { "type": "number" } }
        }
      },
      "Provenance": {
        "type": "object",
        "properties": {
          "provider": { "type": "string" },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "source_type": { "type": "string", "enum": ["live_scan", "cached", "ai_generated", "api_call"] }
        }
      },
      "Cache": {
        "type": "object",
        "properties": {
          "recommended_ttl_seconds": { "type": "integer" },
          "retryable": { "type": "boolean" },
          "cache_recommended": { "type": "boolean" }
        }
      },
      "NextApi": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "api": { "type": "string" },
            "endpoint": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      },
      "Recommendation": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "priority": { "type": "string", "enum": ["high", "medium", "low"] },
            "action": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      },
      "ExecMeta": {
        "type": "object",
        "properties": {
          "latency_ms": { "type": "integer" },
          "model": { "type": "string" },
          "automation_safe": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" },
          "retryable": { "type": "boolean" }
        }
      },
      "FaqSchemaResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "request_id": { "type": "string", "format": "uuid" },
          "data": { "$ref": "#/components/schemas/FaqSchemaData" },
          "confidence": { "$ref": "#/components/schemas/Confidence" },
          "provenance": { "$ref": "#/components/schemas/Provenance" },
          "cache": { "$ref": "#/components/schemas/Cache" },
          "recommended_next_api": { "$ref": "#/components/schemas/NextApi" },
          "recommended_actions_priority_order": { "$ref": "#/components/schemas/Recommendation" },
          "execution_metadata": { "$ref": "#/components/schemas/ExecMeta" }
        }
      },
      "FaqCheckResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "request_id": { "type": "string", "format": "uuid" },
          "data": { "$ref": "#/components/schemas/FaqCheckData" },
          "confidence": { "$ref": "#/components/schemas/Confidence" },
          "provenance": { "$ref": "#/components/schemas/Provenance" },
          "cache": { "$ref": "#/components/schemas/Cache" },
          "recommended_next_api": { "$ref": "#/components/schemas/NextApi" },
          "recommended_actions_priority_order": { "$ref": "#/components/schemas/Recommendation" },
          "execution_metadata": { "$ref": "#/components/schemas/ExecMeta" }
        }
      },
      "ExecutionGateResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "request_id": { "type": "string", "format": "uuid" },
          "execution_ready": { "type": "boolean" },
          "next_api": { "type": "string" },
          "next_endpoint": { "type": "string" },
          "blocking_flags": { "type": "array", "items": { "type": "string" } },
          "confidence": { "$ref": "#/components/schemas/Confidence" },
          "provenance": { "$ref": "#/components/schemas/Provenance" },
          "execution_metadata": { "$ref": "#/components/schemas/ExecMeta" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
