{
  "name": "X/Twitter Post Lookup API",
  "slug": "twitter-post-lookup",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 100,
      "requests_per_month": 3000
    },
    "pay_per_call": {
      "post": "$0.002",
      "profile": "$0.003",
      "engagement": "$0.003",
      "execution_gate": "$0.001",
      "analyze": "$0.006"
    },
    "high_volume": {
      "post": "$0.001",
      "profile": "$0.0015",
      "analyze": "$0.003"
    }
  },
  "rate_limits": {
    "free": "100/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/post",
      "description": "Look up a post"
    },
    {
      "method": "POST",
      "path": "/profile",
      "description": "Get profile metrics"
    },
    {
      "method": "POST",
      "path": "/engagement",
      "description": "Measure engagement"
    },
    {
      "method": "POST",
      "path": "/execution-gate",
      "description": "Execution readiness check"
    },
    {
      "method": "POST",
      "path": "/analyze",
      "description": "ONE-CALL full Twitter/X intelligence",
      "x_one_call": true
    }
  ],
  "execution_chain": {
    "previous": "social-profile-lookup",
    "next": "youtube-metadata",
    "optional_next": []
  }
}