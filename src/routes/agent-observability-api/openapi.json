{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Observability Telemetry API",
    "version": "1.0.0",
    "description": "Collects, stores, and surfaces agent execution traces, spans, and performance telemetry.",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "model": "per_call",
      "unit_cost_usd": 0.002
    }
  },
  "x-execution-gate-required": false,
  "x-paper-mode-recommended": false,
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/agent-observability"
    }
  ],
  "paths": {
    "/discovery": {
      "get": {
        "summary": "Discover Agent Observability Telemetry API capabilities",
        "operationId": "discovery",
        "x-agent-callable": true,
        "tags": [
          "Agent Observability Telemetry API"
        ],
        "responses": {
          "200": {
            "description": "API capability discovery",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "api",
                    "endpoints",
                    "pricing",
                    "human_approval_required"
                  ],
                  "properties": {
                    "api": {
                      "type": "string"
                    },
                    "endpoints": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "pricing": {
                      "type": "object"
                    },
                    "human_approval_required": {
                      "type": "boolean"
                    },
                    "chain_to": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "summary": "Pre-flight execution gate check",
        "operationId": "executionGate",
        "x-agent-callable": true,
        "tags": [
          "Agent Observability Telemetry API"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gate result"
          }
        }
      }
    },
    "/trace": {
      "post": {
        "summary": "Submit an agent execution trace",
        "operationId": "post_trace",
        "x-agent-callable": true,
        "x-mcp-compatible": true,
        "tags": [
          "Agent Observability Telemetry API"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "trace_id",
                    "execution_id",
                    "trace_id",
                    "stored",
                    "span_count"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "trace_id": {
                      "type": "string"
                    },
                    "execution_id": {
                      "type": "string"
                    },
                    "session_id": {
                      "type": "string"
                    },
                    "human_approval_required": {
                      "type": "boolean",
                      "default": false
                    },
                    "stored": {
                      "type": "string"
                    },
                    "span_count": {
                      "type": "string"
                    },
                    "duration_ms": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "trace_id",
                  "session_id"
                ],
                "properties": {
                  "trace_id": {
                    "type": "string"
                  },
                  "session_id": {
                    "type": "string"
                  },
                  "spans": {
                    "type": "string"
                  },
                  "agent_id": {
                    "type": "string"
                  },
                  "workflow_id": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trace/:trace_id": {
      "get": {
        "summary": "Retrieve a stored trace",
        "operationId": "get_trace_trace_id",
        "x-agent-callable": true,
        "x-mcp-compatible": true,
        "tags": [
          "Agent Observability Telemetry API"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "trace_id",
                    "execution_id",
                    "trace_id",
                    "spans",
                    "outcome"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "trace_id": {
                      "type": "string"
                    },
                    "execution_id": {
                      "type": "string"
                    },
                    "session_id": {
                      "type": "string"
                    },
                    "human_approval_required": {
                      "type": "boolean",
                      "default": false
                    },
                    "spans": {
                      "type": "string"
                    },
                    "outcome": {
                      "type": "string"
                    },
                    "duration_ms": {
                      "type": "string"
                    },
                    "agent_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/analyze": {
      "post": {
        "summary": "Analyze traces for failure patterns",
        "operationId": "post_analyze",
        "x-agent-callable": true,
        "x-mcp-compatible": true,
        "tags": [
          "Agent Observability Telemetry API"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "trace_id",
                    "execution_id",
                    "failure_rate",
                    "common_failure_reasons",
                    "bottleneck_spans"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "trace_id": {
                      "type": "string"
                    },
                    "execution_id": {
                      "type": "string"
                    },
                    "session_id": {
                      "type": "string"
                    },
                    "human_approval_required": {
                      "type": "boolean",
                      "default": false
                    },
                    "failure_rate": {
                      "type": "string"
                    },
                    "common_failure_reasons": {
                      "type": "string"
                    },
                    "bottleneck_spans": {
                      "type": "string"
                    },
                    "recommended_actions": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "agent_id",
                  "window_hours"
                ],
                "properties": {
                  "agent_id": {
                    "type": "string"
                  },
                  "window_hours": {
                    "type": "string"
                  },
                  "signal_types": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/:agent_id": {
      "get": {
        "summary": "Get performance dashboard for an agent",
        "operationId": "get_dashboard_agent_id",
        "x-agent-callable": true,
        "x-mcp-compatible": true,
        "tags": [
          "Agent Observability Telemetry API"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "trace_id",
                    "execution_id",
                    "agent_id",
                    "success_rate",
                    "avg_duration_ms"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "trace_id": {
                      "type": "string"
                    },
                    "execution_id": {
                      "type": "string"
                    },
                    "session_id": {
                      "type": "string"
                    },
                    "human_approval_required": {
                      "type": "boolean",
                      "default": false
                    },
                    "agent_id": {
                      "type": "string"
                    },
                    "success_rate": {
                      "type": "string"
                    },
                    "avg_duration_ms": {
                      "type": "string"
                    },
                    "p95_duration_ms": {
                      "type": "string"
                    },
                    "error_breakdown": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}