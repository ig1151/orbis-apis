    "/lookup": {
      "post": {
        "operationId": "lookupPool",
        "summary": "Look up a DeFi pool by address or pair",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "pool_address"
                ],
                "properties": {
                  "pool_address": {
                    "type": "string"
                  },
                  "chain": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "pool_address": "0x88e6A0c2dDD26FEEb64F039a2c41296FcB3f5640",
                "chain": "ethereum"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "trace_id",
                    "computed_at",
                    "success",
                    "protocol",
                    "pair",
                    "tvl_usd",
                    "apy_7d"
                  ],
                  "properties": {
                    "protocol": {
                      "type": "string"
                    },
                    "pair": {
                      "type": "string"
                    },
                    "tvl_usd": {
                      "type": "number"
                    },
                    "volume_24h_usd": {
                      "type": "number"
                    },
                    "apy_7d": {
                      "type": "number"
                    },
                    "fee_tier": {
                      "type": "number"
                    },
                    "trace_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "computed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "source_provenance": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string"
                        },
                        "retrieved_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "freshness_score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "provider",
                        "retrieved_at",
                        "freshness_score"
                      ]
                    },
                    "cache_ttl_seconds": {
                      "type": "integer"
                    },
                    "cache_recommended": {
                      "type": "boolean"
