{
  "openapi": "3.1.0",
  "info": {
    "title": "PDF Generator API",
    "version": "2.0.0",
    "description": "Generate, merge, template, and compress PDF documents from HTML, markdown, or structured data for document automation agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 200
      },
      "pay_per_call": {
        "generate": "$0.010",
        "merge": "$0.008",
        "template": "$0.010",
        "execution-gate": "$0.001",
        "pdf-intelligence": "$0.015",
        "compress": "$0.005",
        "batch": "$0.060"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/pdf-generator"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/generate": {
      "post": {
        "operationId": "generatePdf",
        "summary": "Generate PDF from HTML, markdown, or structured data",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "content_type": {
                    "type": "string",
                    "enum": [
                      "html",
                      "markdown",
                      "json"
                    ]
                  },
                  "options": {
                    "type": "object"
                  }
                },
                "required": [
                  "content"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/merge": {
      "post": {
        "operationId": "mergePdfs",
        "summary": "Merge multiple PDF URLs into one document",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pdf_urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "order": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "required": [
                  "pdf_urls"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/template": {
      "post": {
        "operationId": "generateFromTemplate",
        "summary": "Generate PDF from template with variable substitution",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "template_id": {
                    "type": "string"
                  },
                  "variables": {
                    "type": "object"
                  },
                  "template_content": {
                    "type": "string"
                  }
                },
                "required": [
                  "variables"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/pdf-intelligence": {
      "post": {
        "operationId": "pdfIntelligence",
        "summary": "ONE-CALL: generate + optimize + accessibility check + metadata",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "content_type": {
                    "type": "string"
                  },
                  "purpose": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/compress": {
      "post": {
        "operationId": "compressPdf",
        "summary": "Compress PDF to reduce file size",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pdf_url": {
                    "type": "string"
                  },
                  "quality": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                },
                "required": [
                  "pdf_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchGenerate",
        "summary": "Batch generate up to 10 PDFs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "documents": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 10
                  }
                },
                "required": [
                  "documents"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}