                        "b"
                      ],
                      "properties": {
                        "a": {
                          "type": "string"
                        },
                        "b": {
                          "type": "string"
                        }
                      }
                    },
                    "lower_risk": {
                      "type": "string",
                      "enum": [
                        "a",
                        "b",
                        "equal"
                      ]
                    },
                    "trace_id": {
                      "type": "string",
                      "format": "uuid"
                    },
