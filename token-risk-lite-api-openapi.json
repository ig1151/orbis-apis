    "/assess": {
      "post": {
        "operationId": "assessRisk",
        "summary": "Assess token risk with core safety checks",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contract_address"
                ],
                "properties": {
                  "contract_address": {
                    "type": "string"
                  },
                  "chain": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "contract_address": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
                "chain": "ethereum"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "trace_id",
                    "computed_at",
                    "success",
                    "risk_score",
                    "risk_level",
                    "honeypot",
                    "rug_pull_risk"
                  ],
                  "properties": {
                    "risk_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "risk_level": {
                      "type": "string",
                      "enum": [
                        "safe",
                        "caution",
                        "high-risk",
                        "critical"
                      ]
                    },
                    "honeypot": {
                      "type": "boolean"
                    },
                    "rug_pull_risk": {
                      "type": "string",
                      "enum": [
                        "low",
                        "moderate",
                        "high"
                      ]
                    },
                    "trace_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "computed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "source_provenance": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string"
                        },
                        "retrieved_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "freshness_score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "provider",
                        "retrieved_at",
                        "freshness_score"
                      ]
                    },
                    "cache_ttl_seconds": {
                      "type": "integer"
                    },
                    "cache_recommended": {
                      "type": "boolean"
                    },
                    "recommended_next_api": {
                      "type": "string"
                    },
                    "recommended_next_endpoint": {
                      "type": "string"
                    },
                    "automation_safe": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "risk_score": 4,
                  "risk_level": "safe",
                  "honeypot": false,
                  "rug_pull_risk": "low",
                  "trace_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
