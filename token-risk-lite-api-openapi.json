    "/compare": {
      "post": {
        "operationId": "compareRisk",
        "summary": "Compare risk between two tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contract_address_a",
                  "contract_address_b"
                ],
                "properties": {
