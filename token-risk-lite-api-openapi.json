                }
              },
              "example": {
                "contract_address_a": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
                "contract_address_b": "0xSomeNewToken...",
                "chain": "ethereum"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "trace_id",
                    "computed_at",
                    "success",
                    "risk_scores",
                    "grades",
                    "lower_risk"
                  ],
                  "properties": {
                    "risk_scores": {
                      "type": "object",
                      "required": [
                        "a",
                        "b"
                      ],
                      "properties": {
                        "a": {
                          "type": "number"
                        },
                        "b": {
                          "type": "number"
                        }
                      }
                    },
                    "grades": {
                      "type": "object",
