{
  "name": "Betting Odds API",
  "slug": "betting-odds",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 100,
      "requests_per_month": 3000
    },
    "pay_per_call": {
      "odds": "$0.003",
      "line_movement": "$0.004",
      "best_price": "$0.003",
      "execution_gate": "$0.001",
      "analyze": "$0.006"
    },
    "high_volume": {
      "odds": "$0.0015",
      "line_movement": "$0.002",
      "analyze": "$0.003"
    }
  },
  "rate_limits": {
    "free": "100/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/odds",
      "description": "Get betting odds"
    },
    {
      "method": "POST",
      "path": "/line-movement",
      "description": "Track line movement"
    },
    {
      "method": "POST",
      "path": "/best-price",
      "description": "Find best price"
    },
    {
      "method": "POST",
      "path": "/execution-gate",
      "description": "Execution readiness check"
    },
    {
      "method": "POST",
      "path": "/analyze",
      "description": "ONE-CALL full odds analysis",
      "x_one_call": true
    }
  ],
  "execution_chain": {
    "previous": "sports-scores",
    "next": "social-profile-lookup",
    "optional_next": []
  }
}