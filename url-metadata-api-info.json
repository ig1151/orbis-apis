{
  "name": "URL Metadata API",
  "slug": "url-metadata",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": { "data_stored": false, "retention": "none" },
  "pricing": {
    "free_tier": { "requests_per_day": 500 },
    "pay_per_call": { "fetch": "$0.002", "og-tags": "$0.002", "analyze": "$0.003", "execution-gate": "$0.001", "url-intelligence": "$0.007", "link-preview": "$0.002", "batch": "$0.015" }
  },
  "rate_limits": { "free": "500/day", "paid": "50000/day", "enterprise": "500000/day" },
  "endpoints": ["/fetch", "/og-tags", "/analyze", "/execution-gate", "/url-intelligence", "/link-preview", "/batch"],
  "execution_chain": { "recommended_start": "/url-intelligence", "fallback": "/fetch", "batch_endpoint": "/batch" }
}
