{
  "openapi": "3.1.0",
  "info": {
    "title": "Color Palette API",
    "version": "2.0.0",
    "description": "Extract color palettes from images, generate brand palettes, find color matches, and check WCAG accessibility for design automation agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 500
      },
      "pay_per_call": {
        "extract": "$0.003",
        "generate": "$0.005",
        "match": "$0.002",
        "execution-gate": "$0.001",
        "palette-intelligence": "$0.008",
        "accessibility": "$0.002",
        "batch": "$0.020"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/color-palette"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/extract": {
      "post": {
        "operationId": "extractPalette",
        "summary": "Extract color palette from image",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 20
                  },
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "k-means",
                      "median-cut",
                      "octree"
                    ]
                  }
                },
                "required": [
                  "image_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/generate": {
      "post": {
        "operationId": "generatePalette",
        "summary": "Generate brand color palette from name, industry, or mood",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "brand_name": {
                    "type": "string"
                  },
                  "industry": {
                    "type": "string"
                  },
                  "mood": {
                    "type": "string"
                  },
                  "base_color": {
                    "type": "string"
                  },
                  "style": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/match": {
      "post": {
        "operationId": "matchColors",
        "summary": "Find complementary, analogous, or triadic color matches",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "color": {
                    "type": "string"
                  },
                  "match_type": {
                    "type": "string",
                    "enum": [
                      "complementary",
                      "analogous",
                      "triadic",
                      "split",
                      "tetradic"
                    ]
                  },
                  "count": {
                    "type": "integer"
                  }
                },
                "required": [
                  "color"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/palette-intelligence": {
      "post": {
        "operationId": "paletteIntelligence",
        "summary": "ONE-CALL: extract + brand fit + accessibility + dark mode check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string"
                  },
                  "brand_name": {
                    "type": "string"
                  },
                  "industry": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/accessibility": {
      "post": {
        "operationId": "checkAccessibility",
        "summary": "Check WCAG color accessibility and contrast ratio",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "foreground": {
                    "type": "string"
                  },
                  "background": {
                    "type": "string"
                  },
                  "font_size": {
                    "type": "number"
                  }
                },
                "required": [
                  "foreground",
                  "background"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchExtract",
        "summary": "Batch extract palettes from up to 10 images",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 10
                  }
                },
                "required": [
                  "images"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}