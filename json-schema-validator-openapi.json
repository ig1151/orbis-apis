{
  "openapi": "3.1.0",
  "info": {
    "title": "JSON Schema Validator API",
    "version": "2.0.0",
    "description": "Validate, generate, convert, and infer JSON schemas for API development and data contract automation agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 1000
      },
      "pay_per_call": {
        "validate": "$0.001",
        "generate": "$0.003",
        "convert": "$0.003",
        "execution-gate": "$0.001",
        "schema-intelligence": "$0.005",
        "infer": "$0.003",
        "batch": "$0.010"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/json-schema-validator"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/validate": {
      "post": {
        "operationId": "validateJson",
        "summary": "Validate JSON data against a JSON Schema",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object"
                  },
                  "schema": {
                    "type": "object"
                  },
                  "draft": {
                    "type": "string",
                    "enum": [
                      "draft-07",
                      "draft-2019-09",
                      "draft-2020-12"
                    ]
                  }
                },
                "required": [
                  "data",
                  "schema"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/generate": {
      "post": {
        "operationId": "generateSchema",
        "summary": "Generate JSON Schema from a JSON example",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "example": {
                    "type": "object"
                  },
                  "strict": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "example"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/convert": {
      "post": {
        "operationId": "convertSchema",
        "summary": "Convert between JSON Schema, OpenAPI, and TypeScript types",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "schema": {
                    "type": "object"
                  },
                  "from_format": {
                    "type": "string"
                  },
                  "to_format": {
                    "type": "string",
                    "enum": [
                      "json-schema",
                      "openapi",
                      "typescript",
                      "zod"
                    ]
                  }
                },
                "required": [
                  "schema"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/schema-intelligence": {
      "post": {
        "operationId": "schemaIntelligence",
        "summary": "ONE-CALL: validate + explain errors + suggest fixes + type inference",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object"
                  },
                  "schema": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/infer": {
      "post": {
        "operationId": "inferSchema",
        "summary": "Infer JSON Schema from multiple data samples",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "samples": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "strictness": {
                    "type": "string",
                    "enum": [
                      "strict",
                      "loose"
                    ]
                  }
                },
                "required": [
                  "samples"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchValidate",
        "summary": "Batch validate up to 50 JSON objects",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 50
                  }
                },
                "required": [
                  "items"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}