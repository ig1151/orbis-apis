{
  "name": "Chrome Extension Lookup API",
  "slug": "chrome-extension-lookup",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 300
    },
    "pay_per_call": {
      "lookup": "$0.002",
      "analyze": "$0.004",
      "similar": "$0.003",
      "execution-gate": "$0.001",
      "extension-intelligence": "$0.008"
    }
  },
  "rate_limits": {
    "free": "300/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "lookup",
    "analyze",
    "similar",
    "execution-gate",
    "extension-intelligence"
  ],
  "execution_chain": {
    "recommended_start": "/extension-intelligence",
    "fallback": "/lookup",
    "batch_endpoint": "/lookup"
  }
}