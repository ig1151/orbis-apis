{
  "name": "Disposable Email Detector API",
  "slug": "disposable-email-detector",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
