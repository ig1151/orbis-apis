  "rate_limits": {
    "free": "500/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "/detect",
    "/domain",
    "/execution-gate",
    "/batch"
  ],
  "execution_chain": {
    "recommended_start": "/detect",
    "fallback": "/detect",
    "batch_endpoint": "/batch"
  }
}
