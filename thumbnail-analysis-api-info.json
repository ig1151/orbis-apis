{
  "name": "Thumbnail Analysis API",
  "slug": "thumbnail-analysis",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": { "data_stored": false, "retention": "none" },
  "pricing": {
    "free_tier": { "requests_per_day": 200 },
    "pay_per_call": { "analyze": "$0.005", "score": "$0.003", "suggest": "$0.004", "execution-gate": "$0.001", "thumbnail-intelligence": "$0.010", "compare": "$0.005", "batch": "$0.020" }
  },
  "rate_limits": { "free": "200/day", "paid": "50000/day", "enterprise": "500000/day" },
  "endpoints": ["/analyze", "/score", "/suggest", "/execution-gate", "/thumbnail-intelligence", "/compare", "/batch"],
  "execution_chain": { "recommended_start": "/thumbnail-intelligence", "fallback": "/analyze", "batch_endpoint": "/batch" }
}
