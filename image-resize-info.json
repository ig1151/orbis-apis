{
  "name": "Image Resize API",
  "slug": "image-resize",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 500
    },
    "pay_per_call": {
      "resize": "$0.003",
      "convert": "$0.003",
      "optimize": "$0.003",
      "execution-gate": "$0.001",
      "image-intelligence": "$0.008",
      "crop": "$0.005",
      "batch": "$0.025"
    }
  },
  "rate_limits": {
    "free": "500/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/resize",
      "description": "Resize image to target dimensions"
    },
    {
      "method": "POST",
      "path": "/convert",
      "description": "Convert image format"
    },
    {
      "method": "POST",
      "path": "/optimize",
      "description": "Optimize image for web performance"
    },
    {
      "method": "POST",
      "path": "/execution-gate",
      "description": "Execution readiness check"
    },
    {
      "method": "POST",
      "path": "/image-intelligence",
      "description": "ONE-CALL full image intelligence",
      "x_one_call": true
    },
    {
      "method": "POST",
      "path": "/crop",
      "description": "Smart crop image to subject"
    },
    {
      "method": "POST",
      "path": "/batch",
      "description": "Batch process up to 20 images"
    }
  ],
  "execution_chain": {
    "previous": "npm-package-risk",
    "next": "background-removal",
    "optional_next": []
  }
}