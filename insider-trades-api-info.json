{
  "name": "Insider Trades API",
  "slug": "insider-trades",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": { "data_stored": false, "retention": "none" },
  "pricing": {
    "free_tier": { "requests_per_day": 300 },
    "pay_per_call": { "lookup": "$0.003", "signals": "$0.003", "summary": "$0.003", "execution-gate": "$0.001", "insider-intelligence": "$0.008", "trend": "$0.003", "batch": "$0.015" }
  },
  "rate_limits": { "free": "300/day", "paid": "50000/day", "enterprise": "500000/day" },
  "endpoints": ["/lookup", "/signals", "/summary", "/execution-gate", "/insider-intelligence", "/trend", "/batch"],
  "execution_chain": { "recommended_start": "/insider-intelligence", "fallback": "/lookup", "batch_endpoint": "/batch" }
}
