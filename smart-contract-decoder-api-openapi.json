    "/decode": {
      "post": {
        "operationId": "decodeContract",
        "summary": "Decode contract ABI and function signatures",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contract_address"
                ],
                "properties": {
                  "contract_address": {
                    "type": "string"
                  },
                  "chain": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "contract_address": "0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D",
                "chain": "ethereum"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "trace_id",
                    "computed_at",
                    "success",
                    "contract_name",
                    "functions",
                    "is_proxy"
                  ],
                  "properties": {
                    "contract_name": {
                      "type": "string"
                    },
                    "functions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "signature": {
                            "type": "string"
                          },
                          "is_payable": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "name",
                          "signature"
                        ]
                      }
                    },
                    "is_proxy": {
                      "type": "boolean"
                    },
                    "implementation_address": {
                      "type": "string"
                    },
                    "trace_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "computed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "source_provenance": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string"
                        },
                        "retrieved_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "freshness_score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "provider",
                        "retrieved_at",
                        "freshness_score"
