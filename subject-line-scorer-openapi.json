{
  "openapi": "3.1.0",
  "info": {
    "title": "Subject Line Scorer API",
    "version": "1.0.0",
    "description": "Score email subject lines for open rate potential using sentiment, urgency, personalization, and spam trigger analysis. Generate optimized alternatives.",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 500
      },
      "pay_per_call": {
        "score": "$0.001",
        "optimize": "$0.003",
        "generate": "$0.003",
        "execution-gate": "$0.001",
        "subject-intelligence": "$0.006"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/subject-line-scorer"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/score": {
      "post": {
        "operationId": "score",
        "summary": "Score an email subject line for open rate potential",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score an email subject line for open rate potential"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/optimize": {
      "post": {
        "operationId": "optimize",
        "summary": "Get an optimized version of a subject line",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Get an optimized version of a subject line"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/generate": {
      "post": {
        "operationId": "generate",
        "summary": "Generate high-performing subject line variants",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generate high-performing subject line variants"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gate result"
          }
        }
      }
    },
    "/subject-intelligence": {
      "post": {
        "operationId": "subjectIntelligence",
        "summary": "ONE-CALL: score + optimize + generate variants + spam check",
        "x-one-call": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full intelligence"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}