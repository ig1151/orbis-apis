{
  "name": "Domain Age API",
  "slug": "domain-age",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 300
    },
    "pay_per_call": {
      "age": "$0.001",
      "whois-lite": "$0.001",
      "execution-gate": "$0.001",
      "lookup": "$0.005",
      "batch": "$0.015"
    }
  },
  "rate_limits": {
    "free": "300/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "/age",
    "/whois-lite",
    "/execution-gate",
    "/lookup",
    "/batch"
  ],
  "execution_chain": {
    "recommended_start": "/lookup",
    "fallback": "/age",
    "batch_endpoint": "/batch"
  }
}
