{
  "name": "Text Summarizer API",
  "slug": "text-summarizer",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 100,
      "requests_per_month": 3000
    },
    "pay_per_call": {
      "summarize": "$0.004",
      "bullets": "$0.003",
      "tldr": "$0.002",
      "execution_gate": "$0.001",
      "analyze": "$0.006"
    },
    "high_volume": {
      "summarize": "$0.002",
      "bullets": "$0.0015",
      "analyze": "$0.003"
    }
  },
  "rate_limits": {
    "free": "100/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/summarize",
      "description": "Summarize as paragraph"
    },
    {
      "method": "POST",
      "path": "/bullets",
      "description": "Summarize as bullets"
    },
    {
      "method": "POST",
      "path": "/tldr",
      "description": "Generate TL;DR"
    },
    {
      "method": "POST",
      "path": "/execution-gate",
      "description": "Execution readiness check"
    },
    {
      "method": "POST",
      "path": "/analyze",
      "description": "ONE-CALL full summarization",
      "x_one_call": true
    }
  ],
  "execution_chain": {
    "previous": "audio-transcription",
    "next": "language-detection",
    "optional_next": []
  }
}