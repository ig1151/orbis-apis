    "/availability-intelligence": {
      "post": {
        "operationId": "availabilityIntelligence",
        "summary": "Analyze calendar patterns, predict focus windows, detect burnout risk and optimize availability",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "calendar_data"
                ],
                "properties": {
                  "calendar_data": {
                    "type": "object"
                  },
                  "analysis_period_days": {
                    "type": "number"
                  },
                  "patterns_to_detect": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Availability intelligence report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "availability_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "peak_focus_windows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "day": {
                            "type": "string"
