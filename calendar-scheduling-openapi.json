                    "confidence_per_section": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      }
                    },
                    "recommended_actions_priority_order": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "privacy": {
                      "type": "object",
                      "properties": {
                        "data_stored": {
