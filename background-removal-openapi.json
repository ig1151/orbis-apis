{
  "openapi": "3.1.0",
  "info": {
    "title": "Background Removal API",
    "version": "2.0.0",
    "description": "Remove or replace image backgrounds, generate segmentation masks, and enhance subjects for e-commerce and creative automation agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 200
      },
      "pay_per_call": {
        "remove": "$0.010",
        "replace": "$0.010",
        "mask": "$0.008",
        "execution-gate": "$0.001",
        "background-intelligence": "$0.008",
        "enhance": "$0.008",
        "batch": "$0.040"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/background-removal"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/remove": {
      "post": {
        "operationId": "removeBackground",
        "summary": "Remove background from image",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": [
                      "png",
                      "webp"
                    ]
                  },
                  "crop_to_subject": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "image_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/replace": {
      "post": {
        "operationId": "replaceBackground",
        "summary": "Replace background with new image or color",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string"
                  },
                  "background_url": {
                    "type": "string"
                  },
                  "background_color": {
                    "type": "string"
                  },
                  "blur_background": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "image_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/mask": {
      "post": {
        "operationId": "generateMask",
        "summary": "Generate segmentation mask for subject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string"
                  },
                  "mask_type": {
                    "type": "string",
                    "enum": [
                      "foreground",
                      "background",
                      "subject"
                    ]
                  }
                },
                "required": [
                  "image_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/background-intelligence": {
      "post": {
        "operationId": "backgroundIntelligence",
        "summary": "ONE-CALL: detect subject + recommend operation + quality prediction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string"
                  },
                  "use_case": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/enhance": {
      "post": {
        "operationId": "enhanceSubject",
        "summary": "Enhance subject after background removal \u2014 sharpen, color correct, shadow",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string"
                  },
                  "enhancements": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "sharpen",
                        "color_correct",
                        "shadow",
                        "denoise",
                        "upscale"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchRemove",
        "summary": "Batch remove backgrounds from up to 20 images",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 20
                  }
                },
                "required": [
                  "images"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}