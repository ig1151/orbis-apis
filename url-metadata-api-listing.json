{
  "name": "URL Metadata API",
  "slug": "url-metadata",
  "version": "1.0.0",
  "description": "Fetch URL metadata, extract Open Graph tags, analyze page content and generate link previews for agent-driven web workflows",
  "category": "Web / Search / Scraping",
  "tags": ["url", "metadata", "og-tags", "link-preview", "web-scraping"],
