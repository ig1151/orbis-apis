  },
  "endpoints": ["/fetch", "/og-tags", "/analyze", "/execution-gate", "/url-intelligence", "/link-preview", "/batch"],
  "one_call_endpoint": "/url-intelligence",
  "base_url": "https://orbis-apis.onrender.com/url-metadata",
  "openapi_url": "https://orbis-apis.onrender.com/url-metadata/openapi.json",
  "auth": { "type": "apiKey", "header": "X-API-Key" },
