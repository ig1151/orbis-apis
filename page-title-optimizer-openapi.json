{
  "openapi": "3.1.0",
  "info": {
    "title": "Page Title Optimizer API",
    "version": "2.0.0",
    "description": "Analyze and optimize page titles for SERP performance with confidence scoring, provenance metadata, and execution-gate support."
  },
  "servers": [{ "url": "https://orbis-apis.onrender.com/page-title-optimizer" }],
  "security": [{ "ApiKeyAuth": [] }],
  "paths": {
    "/analyze": {
      "post": {
        "operationId": "analyzePageTitle",
        "summary": "Score a title for length, keyword placement, emotional impact, and CTR potential",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TitleAnalyzeInput" },
              "example": { "title": "10 Best SEO Tips for 2026", "target_keywords": ["SEO tips"] }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Page title analysis result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PageTitleResponse" },
                "example": {
                  "success": true,
                  "request_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "data": {
                    "title": "10 Best SEO Tips for 2026",
                    "char_length": 25,
                    "pixel_width": 220,
                    "is_optimal_length": true,
                    "keyword_present": true,
                    "primary_keyword_position": "middle",
                    "emotional_score": 0.72,
                    "ctr_score": 0.68,
                    "issues": [{ "type": "keyword_position", "description": "Primary keyword not in first 3 words", "severity": "low" }],
                    "recommendations": ["Move 'SEO tips' to beginning of title for better CTR"]
                  },
                  "confidence": { "score": 0.91, "reason": "Keyword and length heuristics applied", "per_section": { "length": 0.99, "emotional": 0.82 } },
                  "provenance": { "provider": "page-title-optimizer", "retrieved_at": "2026-05-18T12:00:00Z", "source_type": "ai_generated" },
                  "cache": { "recommended_ttl_seconds": 86400, "retryable": false, "cache_recommended": true },
                  "recommended_next_api": [{ "api": "ctr-prediction", "endpoint": "/predict", "reason": "Estimate CTR impact of current title" }],
                  "recommended_actions_priority_order": [{ "priority": "medium", "action": "Reorder title to lead with primary keyword", "reason": "First-word keyword placement improves SERP CTR" }],
                  "execution_metadata": { "latency_ms": 310, "model": "title-analyze-v2", "automation_safe": true }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/optimize": {
      "post": {
        "operationId": "optimizePageTitle",
        "summary": "Generate optimized title variants ranked by improvement score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TitleOptimizeInput" },
              "example": { "title": "10 Best SEO Tips for 2026", "target_keywords": ["SEO tips"], "max_length": 60 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Page title optimization result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PageTitleOptimizeResponse" },
                "example": {
                  "success": true,
                  "request_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
                  "data": {
                    "original": "10 Best SEO Tips for 2026",
                    "optimized_variants": [
                      { "title": "SEO Tips 2026: 10 Proven Tactics That Work", "score": 0.91, "changes_made": ["keyword moved to front", "power word added", "specificity increased"] },
                      { "title": "SEO Tips for 2026 — 10 Strategies to Rank Higher", "score": 0.86, "changes_made": ["keyword moved to front", "emotional trigger added"] }
                    ],
                    "best_variant": "SEO Tips 2026: 10 Proven Tactics That Work",
                    "improvement_score": 0.34
                  },
                  "confidence": { "score": 0.88, "reason": "AI variant generation with scoring model", "per_section": { "variants": 0.87, "ranking": 0.89 } },
                  "provenance": { "provider": "page-title-optimizer", "retrieved_at": "2026-05-18T12:01:00Z", "source_type": "ai_generated" },
                  "cache": { "recommended_ttl_seconds": 86400, "retryable": false, "cache_recommended": true },
                  "recommended_next_api": [{ "api": "ctr-prediction", "endpoint": "/predict", "reason": "Validate predicted CTR of best variant" }],
                  "recommended_actions_priority_order": [{ "priority": "high", "action": "Replace title with best variant", "reason": "0.34 improvement score indicates significant SERP gains" }],
                  "execution_metadata": { "latency_ms": 580, "model": "title-optimize-v2", "automation_safe": true }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGatePageTitle",
        "summary": "Evaluate whether title quality meets automated publishing standards",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TitleAnalyzeInput" },
              "example": { "title": "SEO Tips 2026" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution gate result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExecutionGateResponse" },
                "example": {
                  "success": true,
                  "request_id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
                  "execution_ready": true,
                  "next_api": "ctr-prediction",
                  "next_endpoint": "/predict",
                  "blocking_flags": [],
                  "confidence": { "score": 0.95, "reason": "Title meets minimum quality thresholds", "per_section": {} },
                  "provenance": { "provider": "page-title-optimizer", "retrieved_at": "2026-05-18T12:02:00Z", "source_type": "ai_generated" },
                  "execution_metadata": { "latency_ms": 180, "model": "gate-v2", "automation_safe": true }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/title-intelligence": {
      "post": {
        "operationId": "titleIntelligence",
        "summary": "Full intelligence report on title quality with provenance and priority actions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TitleAnalyzeInput" },
              "example": { "title": "Best Practices for Technical SEO in 2026", "target_keywords": ["technical SEO"] }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Title intelligence report",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PageTitleResponse" },
                "example": {
                  "success": true,
                  "request_id": "d4e5f6a7-b8c9-0123-defa-234567890123",
                  "data": {
                    "title": "Best Practices for Technical SEO in 2026",
                    "char_length": 40,
                    "pixel_width": 356,
                    "is_optimal_length": true,
                    "keyword_present": true,
                    "primary_keyword_position": "middle",
                    "emotional_score": 0.55,
                    "ctr_score": 0.61,
                    "issues": [],
                    "recommendations": ["Add a number or power word to increase emotional score"]
                  },
                  "confidence": { "score": 0.93, "reason": "Full title intelligence scan", "per_section": { "length": 0.99, "emotional": 0.87, "keyword": 0.95 } },
                  "provenance": { "provider": "page-title-optimizer", "retrieved_at": "2026-05-18T12:03:00Z", "source_type": "ai_generated" },
                  "cache": { "recommended_ttl_seconds": 86400, "retryable": false, "cache_recommended": true },
                  "recommended_next_api": [{ "api": "featured-snippet-predictor", "endpoint": "/predict", "reason": "Assess snippet eligibility for this title" }],
                  "recommended_actions_priority_order": [{ "priority": "low", "action": "Add emotional trigger word", "reason": "Increases CTR by estimated 5-12%" }],
                  "execution_metadata": { "latency_ms": 420, "model": "intelligence-v2", "automation_safe": true }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-API-Key" }
    },
    "schemas": {
      "TitleAnalyzeInput": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "target_keywords": { "type": "array", "items": { "type": "string" } }
        }
      },
      "TitleOptimizeInput": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "target_keywords": { "type": "array", "items": { "type": "string" } },
          "max_length": { "type": "integer", "default": 60 }
        }
      },
      "TitleIssue": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] }
        }
      },
      "PageTitleData": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "char_length": { "type": "integer" },
          "pixel_width": { "type": "integer" },
          "is_optimal_length": { "type": "boolean" },
          "keyword_present": { "type": "boolean" },
          "primary_keyword_position": { "type": "string", "enum": ["first", "middle", "last", "absent"] },
          "emotional_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "ctr_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "issues": { "type": "array", "items": { "$ref": "#/components/schemas/TitleIssue" } },
          "recommendations": { "type": "array", "items": { "type": "string" } }
        }
      },
      "TitleVariant": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "changes_made": { "type": "array", "items": { "type": "string" } }
        }
      },
      "PageTitleOptimizeData": {
        "type": "object",
        "properties": {
          "original": { "type": "string" },
          "optimized_variants": { "type": "array", "items": { "$ref": "#/components/schemas/TitleVariant" } },
          "best_variant": { "type": "string" },
          "improvement_score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "Confidence": {
        "type": "object",
        "properties": {
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string" },
          "per_section": { "type": "object", "additionalProperties": { "type": "number" } }
        }
      },
      "Provenance": {
        "type": "object",
        "properties": {
          "provider": { "type": "string" },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "source_type": { "type": "string", "enum": ["live_scan", "cached", "ai_generated", "api_call"] }
        }
      },
      "Cache": {
        "type": "object",
        "properties": {
          "recommended_ttl_seconds": { "type": "integer" },
          "retryable": { "type": "boolean" },
          "cache_recommended": { "type": "boolean" }
        }
      },
      "NextApi": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "api": { "type": "string" },
            "endpoint": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      },
      "Recommendation": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "priority": { "type": "string", "enum": ["high", "medium", "low"] },
            "action": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      },
      "ExecMeta": {
        "type": "object",
        "properties": {
          "latency_ms": { "type": "integer" },
          "model": { "type": "string" },
          "automation_safe": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" },
          "retryable": { "type": "boolean" }
        }
      },
      "PageTitleResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "request_id": { "type": "string", "format": "uuid" },
          "data": { "$ref": "#/components/schemas/PageTitleData" },
          "confidence": { "$ref": "#/components/schemas/Confidence" },
          "provenance": { "$ref": "#/components/schemas/Provenance" },
          "cache": { "$ref": "#/components/schemas/Cache" },
          "recommended_next_api": { "$ref": "#/components/schemas/NextApi" },
          "recommended_actions_priority_order": { "$ref": "#/components/schemas/Recommendation" },
          "execution_metadata": { "$ref": "#/components/schemas/ExecMeta" }
        }
      },
      "PageTitleOptimizeResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "request_id": { "type": "string", "format": "uuid" },
          "data": { "$ref": "#/components/schemas/PageTitleOptimizeData" },
          "confidence": { "$ref": "#/components/schemas/Confidence" },
          "provenance": { "$ref": "#/components/schemas/Provenance" },
          "cache": { "$ref": "#/components/schemas/Cache" },
          "recommended_next_api": { "$ref": "#/components/schemas/NextApi" },
          "recommended_actions_priority_order": { "$ref": "#/components/schemas/Recommendation" },
          "execution_metadata": { "$ref": "#/components/schemas/ExecMeta" }
        }
      },
      "ExecutionGateResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "request_id": { "type": "string", "format": "uuid" },
          "execution_ready": { "type": "boolean" },
          "next_api": { "type": "string" },
          "next_endpoint": { "type": "string" },
          "blocking_flags": { "type": "array", "items": { "type": "string" } },
          "confidence": { "$ref": "#/components/schemas/Confidence" },
          "provenance": { "$ref": "#/components/schemas/Provenance" },
          "execution_metadata": { "$ref": "#/components/schemas/ExecMeta" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
