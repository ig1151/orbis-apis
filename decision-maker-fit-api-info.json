  "rate_limits": { "free": "200/day", "paid": "50000/day", "enterprise": "500000/day" },
  "endpoints": ["/score", "/persona", "/outreach-angle", "/execution-gate", "/fit-intelligence", "/buying-signals", "/batch"],
  "execution_chain": { "recommended_start": "/fit-intelligence", "fallback": "/score", "batch_endpoint": "/batch" }
}
