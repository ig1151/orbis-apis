{
  "name": "CTA Generator API",
  "slug": "cta-generator",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 300
    },
    "pay_per_call": {
      "generate": "$0.003",
      "score": "$0.002",
      "ab-variants": "$0.005",
      "execution-gate": "$0.001",
      "cta-intelligence": "$0.008"
    }
  },
  "rate_limits": {
    "free": "300/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "generate",
    "score",
    "ab-variants",
    "execution-gate",
    "cta-intelligence"
  ],
  "execution_chain": {
    "recommended_start": "/cta-intelligence",
    "fallback": "/generate",
    "batch_endpoint": "/generate"
  }
}