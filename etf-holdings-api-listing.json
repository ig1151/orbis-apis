  },
  "endpoints": ["/lookup", "/top-holdings", "/sector-breakdown", "/execution-gate", "/etf-intelligence", "/compare", "/batch"],
  "one_call_endpoint": "/etf-intelligence",
  "base_url": "https://orbis-apis.onrender.com/etf-holdings",
  "openapi_url": "https://orbis-apis.onrender.com/etf-holdings/openapi.json",
  "auth": { "type": "apiKey", "header": "X-API-Key" },
  "grade": "A+",
  "mcp_compatible": true,
  "agent_callable": true,
  "privacy": { "data_stored": false, "retention": "none" }
