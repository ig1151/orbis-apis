{
  "name": "ETF Holdings API",
  "slug": "etf-holdings",
  "version": "1.0.0",
  "description": "Look up ETF holdings, analyze top positions, break down sector allocations and compare ETFs for portfolio management agents",
  "category": "Finance / Market",
