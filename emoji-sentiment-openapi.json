{
  "openapi": "3.1.0",
  "info": {
    "title": "Emoji Sentiment API",
    "version": "1.0.0",
    "description": "Analyze the emotional sentiment of emoji usage in text, decode emoji meaning, and suggest contextually appropriate emojis for content.",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 1000
      },
      "pay_per_call": {
        "analyze": "$0.002",
        "suggest": "$0.002",
        "decode": "$0.001",
        "execution-gate": "$0.001",
        "emoji-intelligence": "$0.005"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/emoji-sentiment"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/analyze": {
      "post": {
        "operationId": "analyze",
        "summary": "Analyze emoji sentiment and emotional tone in text",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analyze emoji sentiment and emotional tone in text"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/suggest": {
      "post": {
        "operationId": "suggest",
        "summary": "Suggest relevant emojis for a given text or topic",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Suggest relevant emojis for a given text or topic"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/decode": {
      "post": {
        "operationId": "decode",
        "summary": "Decode emoji meanings and cultural context",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decode emoji meanings and cultural context"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gate result"
          }
        }
      }
    },
    "/emoji-intelligence": {
      "post": {
        "operationId": "emojiIntelligence",
        "summary": "ONE-CALL: sentiment analysis + suggestions + emotional profile",
        "x-one-call": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full intelligence"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}