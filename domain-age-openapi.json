                    "ready",
                    "gate_passed"
                  ],
                  "properties": {
                    "ready": {
                      "type": "boolean"
                    },
                    "gate_passed": {
                      "type": "boolean"
                    },
                    "blocking_reason": {
                      "type": "string"
