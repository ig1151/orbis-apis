{
  "openapi": "3.1.0",
  "info": {
    "title": "Domain Age API",
    "version": "1.0.0",
    "description": "Returns domain registration date, age in days and years, registrar, and expiry date. Ideal for trust scoring, spam detection, and due diligence agents.",
