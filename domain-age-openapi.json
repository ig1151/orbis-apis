                    "trace_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "computed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "source_provenance": {
                      "type": "object",
                      "required": [
                        "provider",
                        "retrieved_at",
                        "freshness_score"
                      ],
                      "properties": {
