    "/batch": {
      "post": {
        "operationId": "batchDomainAge",
        "summary": "Batch domain age lookup \u2014 up to 20 domains",
        "x-pricing": {
          "pricePerCallUsdc": 0.015
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "domains"
                ],
                "properties": {
                  "domains": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}$"
                    }
                  }
                }
              },
              "example": {
                "domains": [
                  "example.com",
                  "google.com"
                ]
