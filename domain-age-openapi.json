    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 300
      },
      "pay_per_call": {
        "age": "$0.001",
        "whois-lite": "$0.001",
        "execution-gate": "$0.001",
        "lookup": "$0.005",
        "batch": "$0.015"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/domain-age"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
