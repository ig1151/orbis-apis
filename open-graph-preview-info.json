{
  "name": "Open Graph Preview API",
  "slug": "open-graph-preview",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 300
    },
    "pay_per_call": {
      "preview": "$0.003",
      "validate": "$0.002",
      "generate": "$0.004",
      "execution-gate": "$0.001",
      "og-intelligence": "$0.008"
    }
  },
  "rate_limits": {
    "free": "300/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "preview",
    "validate",
    "generate",
    "execution-gate",
    "og-intelligence"
  ],
  "execution_chain": {
    "recommended_start": "/og-intelligence",
    "fallback": "/preview",
    "batch_endpoint": "/preview"
  }
}