                    "freshness_score": 0.95
                  },
                  "cache_ttl_seconds": 3600,
                  "cache_recommended": true,
                  "recommended_next_api": "orbis-apis.onrender.com",
                  "recommended_next_endpoint": null,
                  "automation_safe": true
