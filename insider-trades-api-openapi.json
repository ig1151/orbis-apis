    "/lookup": {
      "post": {
        "operationId": "lookupTrades",
        "summary": "Look up recent insider trades for a ticker",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ticker"
                ],
                "properties": {
                  "ticker": {
                    "type": "string"
                  },
                  "lookback_days": {
                    "type": "integer"
                  }
                }
              },
              "example": {
                "ticker": "NVDA",
                "lookback_days": 30
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "trace_id",
                    "computed_at",
                    "success",
                    "ticker",
                    "trades",
                    "total_trades"
                  ],
                  "properties": {
                    "ticker": {
                      "type": "string"
                    },
                    "company_name": {
                      "type": "string"
                    },
                    "trades": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "insider_name": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "transaction_type": {
                            "type": "string",
                            "enum": [
                              "buy",
                              "sell"
                            ]
                          },
                          "shares": {
                            "type": "integer"
                          },
                          "value_usd": {
                            "type": "number"
                          },
                          "date": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "transaction_type",
                          "value_usd",
                          "date"
                        ]
                      }
                    },
                    "total_trades": {
                      "type": "integer"
                    },
                    "trace_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "computed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "source_provenance": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string"
                        },
                        "retrieved_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "freshness_score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "provider",
                        "retrieved_at",
                        "freshness_score"
                      ]
                    },
                    "cache_ttl_seconds": {
                      "type": "integer"
                    },
                    "cache_recommended": {
                      "type": "boolean"
                    },
                    "recommended_next_api": {
                      "type": "string"
                    },
                    "recommended_next_endpoint": {
                      "type": "string"
                    },
                    "automation_safe": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "ticker": "NVDA",
                  "company_name": "NVIDIA Corporation",
                  "trades": [
                    {
                      "insider_name": "Jensen Huang",
                      "title": "CEO",
                      "transaction_type": "sell",
                      "shares": 240000,
                      "value_usd": 112800000,
                      "date": "2026-05-01"
                    }
                  ],
                  "total_trades": 1,
                  "trace_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "computed_at": "2026-05-17T12:00:00Z",
                  "success": true,
