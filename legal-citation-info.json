{
  "name": "Legal Citation API",
  "slug": "legal-citation",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 300
    },
    "pay_per_call": {
      "parse": "$0.003",
      "validate": "$0.002",
      "cross-reference": "$0.005",
      "execution-gate": "$0.001",
      "legal-intelligence": "$0.010",
      "format": "$0.002",
      "batch": "$0.020"
    }
  },
  "rate_limits": {
    "free": "300/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/parse",
      "description": "Parse legal citation"
    },
    {
      "method": "POST",
      "path": "/validate",
      "description": "Validate citation format"
    },
    {
      "method": "POST",
      "path": "/cross-reference",
      "description": "Cross-reference citations"
    },
    {
      "method": "POST",
      "path": "/execution-gate",
      "description": "Execution readiness check"
    },
    {
      "method": "POST",
      "path": "/legal-intelligence",
      "description": "ONE-CALL full legal citation intelligence",
      "x_one_call": true
    },
    {
      "method": "POST",
      "path": "/format",
      "description": "Format citation to standard style"
    },
    {
      "method": "POST",
      "path": "/batch",
      "description": "Batch process up to 50 citations"
    }
  ],
  "execution_chain": {
    "previous": "contract-clause",
    "next": "table-extraction",
    "optional_next": []
  }
}