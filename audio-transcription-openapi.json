{
  "openapi": "3.1.0",
  "info": {
    "title": "Audio Transcription API",
    "version": "1.0.0",
    "description": "Transcribe audio files with timestamps, speaker labels, and summaries for meeting intelligence, compliance recording, and voice workflow automation agents.",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 100,
        "requests_per_month": 3000
      },
      "pay_per_call": {
        "transcribe": "$0.008",
        "timestamps": "$0.006",
        "summary": "$0.005",
        "execution-gate": "$0.001",
        "analyze": "$0.012"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/audio-transcription"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/transcribe": {
      "post": {
        "operationId": "transcribe",
        "summary": "Transcribe audio",
        "x-one-call": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transcribe audio"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal error"
          }
        }
      }
    },
    "/timestamps": {
      "post": {
        "operationId": "timestamps",
        "summary": "Transcribe with timestamps",
        "x-one-call": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transcribe with timestamps"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal error"
          }
        }
      }
    },
    "/summary": {
      "post": {
        "operationId": "summary",
        "summary": "Transcribe and summarize",
        "x-one-call": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transcribe and summarize"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "x-one-call": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution readiness check"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal error"
          }
        }
      }
    },
    "/analyze": {
      "post": {
        "operationId": "analyze",
        "summary": "ONE-CALL full audio intelligence",
        "x-one-call": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ONE-CALL full audio intelligence"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}