{
  "openapi": "3.1.0",
  "info": {
    "title": "Legal Citation API",
    "version": "2.0.0",
    "description": "Parse, validate, cross-reference, and format legal citations for legal research and document automation agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 300
      },
      "pay_per_call": {
        "parse": "$0.003",
        "validate": "$0.002",
        "cross-reference": "$0.005",
        "execution-gate": "$0.001",
        "legal-intelligence": "$0.010",
        "format": "$0.002",
        "batch": "$0.020"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/legal-citation"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/parse": {
      "post": {
        "operationId": "parseCitation",
        "summary": "Parse legal citation into structured components",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "citation": {
                    "type": "string"
                  },
                  "jurisdiction": {
                    "type": "string"
                  }
                },
                "required": [
                  "citation"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/validate": {
      "post": {
        "operationId": "validateCitation",
        "summary": "Validate citation format and completeness",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "citation": {
                    "type": "string"
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "bluebook",
                      "apa",
                      "chicago",
                      "oscola"
                    ]
                  }
                },
                "required": [
                  "citation"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/cross-reference": {
      "post": {
        "operationId": "crossReference",
        "summary": "Cross-reference citations for related cases and statutes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "depth": {
                    "type": "integer"
                  }
                },
                "required": [
                  "citations"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "citation": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/legal-intelligence": {
      "post": {
        "operationId": "legalIntelligence",
        "summary": "ONE-CALL: parse + validate + cross-reference + format",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "citation": {
                    "type": "string"
                  },
                  "style": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/format": {
      "post": {
        "operationId": "formatCitation",
        "summary": "Format citation to standard citation style",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "citation": {
                    "type": "string"
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "bluebook",
                      "apa",
                      "chicago",
                      "oscola"
                    ]
                  }
                },
                "required": [
                  "citation",
                  "style"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchProcess",
        "summary": "Batch process up to 50 citations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 50
                  }
                },
                "required": [
                  "citations"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}