{
  "name": "Markdown Cleaner API",
  "slug": "markdown-cleaner",
  "version": "1.0.0",
  "description": "Clean and format Markdown documents, lint for style issues, extract document structure and normalize for publishing pipelines",
  "category": "Web / Search / Scraping",
  "tags": ["markdown", "formatting", "linting", "documentation", "content"],
  "pricing": {
    "free_tier": { "requests_per_day": 500 },
    "pay_per_call": { "clean": "$0.002", "format": "$0.002", "lint": "$0.002", "execution-gate": "$0.001", "markdown-intelligence": "$0.006", "extract-structure": "$0.003", "batch": "$0.015" }
  },
  "endpoints": ["/clean", "/format", "/lint", "/execution-gate", "/markdown-intelligence", "/extract-structure", "/batch"],
  "one_call_endpoint": "/markdown-intelligence",
  "base_url": "https://orbis-apis.onrender.com/markdown-cleaner",
  "openapi_url": "https://orbis-apis.onrender.com/markdown-cleaner/openapi.json",
  "auth": { "type": "apiKey", "header": "X-API-Key" },
  "grade": "A+",
  "mcp_compatible": true,
  "agent_callable": true,
  "privacy": { "data_stored": false, "retention": "none" }
}
