    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 300
      },
      "pay_per_call": {
        "spf": "$0.001",
        "dkim": "$0.001",
        "dmarc": "$0.001",
        "check": "$0.005",
        "execution-gate": "$0.001",
        "batch": "$0.012"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/spf-dkim-dmarc-checker"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
