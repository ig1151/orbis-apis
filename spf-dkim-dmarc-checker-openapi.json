                    },
                    "key_type": {
                      "type": "string"
                    },
                    "key_bits": {
                      "type": "integer"
                    },
                    "trace_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "computed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "success": {
                      "type": "boolean"
