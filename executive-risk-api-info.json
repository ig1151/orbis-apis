  },
  "rate_limits": { "free": "200/day", "paid": "50000/day", "enterprise": "500000/day" },
  "endpoints": ["/assess", "/red-flags", "/reputation", "/execution-gate", "/executive-intelligence", "/news-signals", "/batch"],
  "execution_chain": { "recommended_start": "/executive-intelligence", "fallback": "/assess", "batch_endpoint": "/batch" }
}
