{
  "name": "LinkedIn Post Optimizer API",
  "slug": "linkedin-post-optimizer",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 500
    },
    "pay_per_call": {
      "optimize": "$0.003",
      "score": "$0.002",
      "execution-gate": "$0.001",
      "linkedin-intelligence": "$0.006"
    }
  },
  "rate_limits": {
    "free": "500/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "optimize",
    "score",
    "execution-gate",
    "linkedin-intelligence"
  ],
  "execution_chain": {
    "recommended_start": "/linkedin-intelligence",
    "fallback": "/optimize",
    "batch_endpoint": "/optimize"
  }
}
