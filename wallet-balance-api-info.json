{
  "name": "Wallet Balance API",
  "slug": "wallet-balance",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": { "data_stored": false, "retention": "none" },
  "pricing": {
    "free_tier": { "requests_per_day": 300 },
    "pay_per_call": { "lookup": "$0.002", "portfolio": "$0.003", "history": "$0.003", "execution-gate": "$0.001", "wallet-intelligence": "$0.008", "net-worth": "$0.004", "batch": "$0.015" }
  },
  "rate_limits": { "free": "300/day", "paid": "50000/day", "enterprise": "500000/day" },
  "endpoints": ["/lookup", "/portfolio", "/history", "/execution-gate", "/wallet-intelligence", "/net-worth", "/batch"],
  "execution_chain": { "recommended_start": "/wallet-intelligence", "fallback": "/lookup", "batch_endpoint": "/batch" }
}
