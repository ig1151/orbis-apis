{
  "openapi": "3.1.0",
  "info": {
    "title": "Invoice Parser API",
    "version": "2.0.0",
    "description": "Extract line items, totals, vendor info, and payment terms from invoice documents for AP automation agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 300
      },
      "pay_per_call": {
        "parse": "$0.005",
        "extract-line-items": "$0.005",
        "classify": "$0.003",
        "execution-gate": "$0.001",
        "invoice-intelligence": "$0.010",
        "validate": "$0.003",
        "batch": "$0.040"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/invoice-parser"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/parse": {
      "post": {
        "operationId": "parseInvoice",
        "summary": "Parse invoice document \u2014 extract vendor, amounts, dates, line items",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": [
                      "structured",
                      "raw",
                      "markdown"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/extract-line-items": {
      "post": {
        "operationId": "extractLineItems",
        "summary": "Extract invoice line items with quantities, prices, and descriptions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                },
                "required": [
                  "document_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/classify": {
      "post": {
        "operationId": "classifyInvoice",
        "summary": "Classify invoice type \u2014 vendor, contractor, utility, recurring",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/invoice-intelligence": {
      "post": {
        "operationId": "invoiceIntelligence",
        "summary": "ONE-CALL: parse + classify + validate + anomaly detection",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/validate": {
      "post": {
        "operationId": "validateInvoice",
        "summary": "Validate invoice fields \u2014 completeness, format, totals",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchParse",
        "summary": "Batch parse up to 20 invoices",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "documents": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 20
                  }
                },
                "required": [
                  "documents"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}