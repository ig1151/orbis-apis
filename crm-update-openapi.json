    "/crm-workflow": {
      "post": {
        "operationId": "crmWorkflow",
        "summary": "ONE-CALL: full CRM workflow — contact creation, opportunity update, activity logging, task scheduling and pipeline health",
        "x-one-call": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contact_name",
                  "contact_email"
                ],
                "properties": {
                  "contact_name": {
                    "type": "string"
                  },
                  "contact_email": {
                    "type": "string"
                  },
                  "company": {
                    "type": "string"
