                      ]
                    },
                    "field_mapping": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "source_field": {
                            "type": "string"
                          },
                          "target_field": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          },
                          "conflict": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "data_quality_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "enrichment_suggestions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
