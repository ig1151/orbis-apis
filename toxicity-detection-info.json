{
  "name": "Toxicity Detection API",
  "slug": "toxicity-detection",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 500
    },
    "pay_per_call": {
      "detect": "$0.002",
      "batch": "$0.001",
      "execution-gate": "$0.001",
      "toxicity-intelligence": "$0.006"
    }
  },
  "rate_limits": {
    "free": "500/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "detect",
    "batch",
    "execution-gate",
    "toxicity-intelligence"
  ],
  "execution_chain": {
    "recommended_start": "/toxicity-intelligence",
    "fallback": "/detect",
    "batch_endpoint": "/batch"
  }
}
