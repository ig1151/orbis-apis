              "example": {
                "initial_investment": 100000,
                "cashflows": [
                  30000,
                  30000,
                  30000,
                  30000,
                  30000
                ],
                "periods_per_year": 1
              }
            }
          }
        },
        "x-pricing": {
          "model": "per_call",
          "price_usdc": 0.007,
          "currency": "USDC"
        }
      }
    },
