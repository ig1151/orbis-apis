                  -3.4,
                  0.5
                ],
                "series_b": [
                  0.9,
                  -0.5,
                  1.7,
                  -2.9,
                  0.2
                ]
              }
            }
          }
        },
        "x-pricing": {
          "model": "per_call",
          "price_usdc": 0.008,
          "currency": "USDC"
        }
