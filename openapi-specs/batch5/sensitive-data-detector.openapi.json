                    "auth": {
                        "type": "object",
                        "required": [
                            "type",
                            "header"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "type": {
                                "type": "string"
                            },
                            "header": {
                                "type": "string"
                            }
                        }
                    },
                    "endpoints": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "method",
                                "path",
                                "summary",
                                "price_usdc"
