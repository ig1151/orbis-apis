                "additionalProperties": false,
                "properties": {
                    "data_stored": {
                        "type": "boolean"
                    },
                    "retention": {
                        "type": "string",
                        "description": "Retention policy, e.g. \"none\"."
                    }
                }
            },
            "EnvelopeError": {
