                                },
                                "currency": {
                                    "type": "string",
                                    "enum": [
                                        "USDC"
                                    ]
                                }
                            }
                        }
                    },
                    "x402_compatible": {
                        "type": "boolean"
                    },
                    "capabilities": {
                        "type": "array",
