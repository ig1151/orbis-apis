                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PriceRequest"
                            },
                            "example": {
                                "face": 1000,
                                "coupon_rate": 5,
                                "years_to_maturity": 10,
                                "frequency": 2,
                                "yield_rate": 6
                            }
                        }
                    }
                },
                "x-pricing": {
                    "model": "per_call",
                    "price_usdc": 0.015,
                    "currency": "USDC"
                },
                "x-one-call": true
            }
