                      "price_usdc": 0.008,
                      "currency": "USDC"
                    },
                    {
                      "path": "/capm",
                      "price_usdc": 0.006,
                      "currency": "USDC"
                    },
                    {
                      "path": "/lookup",
                      "price_usdc": 0.014,
                      "currency": "USDC"
                    }
