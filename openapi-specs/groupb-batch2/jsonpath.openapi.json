                                        "book": [
                                            {
                                                "title": "A",
                                                "price": 8
                                            },
                                            {
                                                "title": "B",
                                                "price": 12
                                            }
                                        ]
                                    }
                                },
                                "path": "$.store.book[*].title"
                            }
                        }
                    }
                },
                "x-pricing": {
                    "model": "per_call",
                    "price_usdc": 0.007,
                    "currency": "USDC"
                }
