{
  "name": "CRM Contact Intelligence API",
  "slug": "crm-contact-intelligence",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": { "data_stored": false, "retention": "none" },
  "pricing": {
    "free_tier": { "requests_per_day": 200 },
    "pay_per_call": { "enrich": "$0.004", "score": "$0.003", "segment": "$0.003", "execution-gate": "$0.001", "contact-intelligence": "$0.010", "intent-signals": "$0.005", "batch": "$0.020" }
  },
  "rate_limits": { "free": "200/day", "paid": "50000/day", "enterprise": "500000/day" },
  "endpoints": ["/enrich", "/score", "/segment", "/execution-gate", "/contact-intelligence", "/intent-signals", "/batch"],
  "execution_chain": { "recommended_start": "/contact-intelligence", "fallback": "/enrich", "batch_endpoint": "/batch" }
}
