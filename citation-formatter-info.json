{
  "name": "Citation Formatter API",
  "slug": "citation-formatter",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 500
    },
    "pay_per_call": {
      "format": "$0.002",
      "convert": "$0.002",
      "execution-gate": "$0.001",
      "formatter-intelligence": "$0.006"
    }
  },
  "rate_limits": {
    "free": "500/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "format",
    "convert",
    "execution-gate",
    "formatter-intelligence"
  ],
  "execution_chain": {
    "recommended_start": "/formatter-intelligence",
    "fallback": "/format",
    "batch_endpoint": "/format"
  }
}
