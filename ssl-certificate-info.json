{
  "name": "SSL Certificate API",
  "slug": "ssl-certificate",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 500
    },
    "pay_per_call": {
      "check": "$0.002",
      "analyze": "$0.003",
      "monitor": "$0.003",
      "execution-gate": "$0.001",
      "ssl-intelligence": "$0.008",
      "scan": "$0.005",
      "batch": "$0.025"
    }
  },
  "rate_limits": {
    "free": "500/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/check",
      "description": "Check SSL certificate status"
    },
    {
      "method": "POST",
      "path": "/analyze",
      "description": "Analyze certificate details"
    },
    {
      "method": "POST",
      "path": "/monitor",
      "description": "Monitor certificate expiry"
    },
    {
      "method": "POST",
      "path": "/execution-gate",
      "description": "Execution readiness check"
    },
    {
      "method": "POST",
      "path": "/ssl-intelligence",
      "description": "ONE-CALL full SSL intelligence",
      "x_one_call": true
    },
    {
      "method": "POST",
      "path": "/scan",
      "description": "Scan full certificate chain"
    },
    {
      "method": "POST",
      "path": "/batch",
      "description": "Batch check up to 20 domains"
    }
  ],
  "execution_chain": {
    "previous": "api-health-check",
    "next": "dns-lookup",
    "optional_next": []
  }
}