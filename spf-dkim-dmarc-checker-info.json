{
  "name": "SPF/DKIM/DMARC Checker API",
  "slug": "spf-dkim-dmarc-checker",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 300
    },
    "pay_per_call": {
      "spf": "$0.001",
      "dkim": "$0.001",
      "dmarc": "$0.001",
      "check": "$0.005",
      "execution-gate": "$0.001",
      "batch": "$0.012"
    }
  },
  "rate_limits": {
    "free": "300/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "/spf",
    "/dkim",
    "/dmarc",
    "/check",
    "/execution-gate",
    "/batch"
  ],
  "execution_chain": {
    "recommended_start": "/check",
    "fallback": "/spf",
    "batch_endpoint": "/batch"
  }
}
