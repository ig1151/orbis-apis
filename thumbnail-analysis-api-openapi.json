    "/compare": {
      "post": {
        "operationId": "compareThumbnails",
        "summary": "Compare two thumbnails head-to-head",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "image_url_a",
                  "image_url_b"
