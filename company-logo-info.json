{
  "name": "Company Logo API",
  "slug": "company-logo",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 300
    },
    "pay_per_call": {
      "logo": "$0.001",
      "favicon": "$0.001",
      "brand-assets": "$0.003",
      "execution-gate": "$0.001",
      "batch": "$0.010"
    }
  },
  "rate_limits": {
    "free": "300/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "/logo",
    "/favicon",
    "/brand-assets",
    "/execution-gate",
    "/batch"
  ],
  "execution_chain": {
    "recommended_start": "/brand-assets",
    "fallback": "/logo",
    "batch_endpoint": "/batch"
  }
}
