{
  "name": "Subject Line Scorer API",
  "slug": "subject-line-scorer",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 500
    },
    "pay_per_call": {
      "score": "$0.001",
      "optimize": "$0.003",
      "generate": "$0.003",
      "execution-gate": "$0.001",
      "subject-intelligence": "$0.006"
    }
  },
  "rate_limits": {
    "free": "500/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "score",
    "optimize",
    "generate",
    "execution-gate",
    "subject-intelligence"
  ],
  "execution_chain": {
    "recommended_start": "/subject-intelligence",
    "fallback": "/score",
    "batch_endpoint": "/score"
  }
}