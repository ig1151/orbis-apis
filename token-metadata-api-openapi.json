    "/lookup": {
      "post": {
        "operationId": "lookupToken",
        "summary": "Look up token metadata by contract address",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contract_address"
                ],
                "properties": {
                  "contract_address": {
                    "type": "string"
                  },
                  "chain": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "contract_address": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
                "chain": "ethereum"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "trace_id",
                    "computed_at",
                    "success",
                    "symbol",
                    "name",
                    "decimals",
                    "token_type",
                    "verified"
                  ],
                  "properties": {
                    "symbol": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "decimals": {
                      "type": "integer"
                    },
                    "token_type": {
                      "type": "string",
                      "enum": [
                        "ERC-20",
                        "ERC-721",
                        "ERC-1155",
                        "BEP-20",
                        "SPL",
                        "other"
                      ]
                    },
                    "verified": {
                      "type": "boolean"
                    },
                    "total_supply": {
                      "type": "string"
                    },
                    "contract_address": {
                      "type": "string"
                    },
                    "trace_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "computed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "source_provenance": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string"
                        },
                        "retrieved_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "freshness_score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "provider",
                        "retrieved_at",
                        "freshness_score"
                      ]
                    },
                    "cache_ttl_seconds": {
                      "type": "integer"
                    },
                    "cache_recommended": {
                      "type": "boolean"
                    },
                    "recommended_next_api": {
                      "type": "string"
                    },
                    "recommended_next_endpoint": {
                      "type": "string"
                    },
                    "automation_safe": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "symbol": "USDC",
                  "name": "USD Coin",
                  "decimals": 6,
                  "token_type": "ERC-20",
                  "verified": true,
                  "total_supply": "43500000000000000",
                  "contract_address": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
                  "trace_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "computed_at": "2026-05-17T12:00:00Z",
                  "success": true,
                  "source_provenance": {
                    "provider": "orbis-intelligence",
                    "retrieved_at": "2026-05-17T12:00:00Z",
                    "freshness_score": 0.95
                  },
                  "cache_ttl_seconds": 3600,
                  "cache_recommended": true,
                  "recommended_next_api": "orbis-apis.onrender.com",
                  "recommended_next_endpoint": null,
                  "automation_safe": true
