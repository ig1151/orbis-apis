{
  "openapi": "3.1.0",
  "info": {
    "title": "Meme Caption Generator API",
    "version": "2.0.0",
    "description": "Generate meme captions, analyze meme formats, localize for audiences, and identify trending templates for social media automation agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 500
      },
      "pay_per_call": {
        "generate": "$0.003",
        "analyze": "$0.003",
        "localize": "$0.005",
        "execution-gate": "$0.001",
        "meme-intelligence": "$0.008",
        "trending": "$0.003",
        "batch": "$0.020"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/meme-caption"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/generate": {
      "post": {
        "operationId": "generateCaptions",
        "summary": "Generate meme captions for a topic or template",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "template": {
                    "type": "string"
                  },
                  "tone": {
                    "type": "string",
                    "enum": [
                      "humorous",
                      "sarcastic",
                      "wholesome",
                      "dark",
                      "professional"
                    ]
                  },
                  "audience": {
                    "type": "string"
                  }
                },
                "required": [
                  "topic"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/analyze": {
      "post": {
        "operationId": "analyzeMeme",
        "summary": "Analyze meme format, humor type, and virality potential",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string"
                  },
                  "caption": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/localize": {
      "post": {
        "operationId": "localizeMeme",
        "summary": "Localize meme caption for target audience or locale",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "caption": {
                    "type": "string"
                  },
                  "top_text": {
                    "type": "string"
                  },
                  "bottom_text": {
                    "type": "string"
                  },
                  "target_locale": {
                    "type": "string"
                  },
                  "target_audience": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/meme-intelligence": {
      "post": {
        "operationId": "memeIntelligence",
        "summary": "ONE-CALL: caption + template + hashtags + posting time + brand safety",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "brand": {
                    "type": "string"
                  },
                  "campaign": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/trending": {
      "post": {
        "operationId": "getTrending",
        "summary": "Get trending meme formats and templates",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchGenerate",
        "summary": "Batch generate captions for up to 10 topics",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topics": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 10
                  }
                },
                "required": [
                  "topics"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}