{
  "name": "Blockchain Transaction Lookup API",
  "slug": "blockchain-tx-lookup",
  "version": "1.0.0",
  "description": "Look up blockchain transactions, decode calldata, trace internal calls and assess transaction risk for onchain compliance agents",
  "category": "Crypto / Onchain",
  "tags": ["blockchain", "transactions", "defi", "compliance", "trace"],
  "pricing": {
    "free_tier": { "requests_per_day": 300 },
