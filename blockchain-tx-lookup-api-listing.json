  },
  "endpoints": ["/lookup", "/decode", "/trace", "/execution-gate", "/tx-intelligence", "/risk", "/batch"],
  "one_call_endpoint": "/tx-intelligence",
  "base_url": "https://orbis-apis.onrender.com/blockchain-tx-lookup",
  "openapi_url": "https://orbis-apis.onrender.com/blockchain-tx-lookup/openapi.json",
  "auth": { "type": "apiKey", "header": "X-API-Key" },
  "grade": "A+",
  "mcp_compatible": true,
  "agent_callable": true,
  "privacy": { "data_stored": false, "retention": "none" }
}
