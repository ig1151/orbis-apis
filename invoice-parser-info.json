{
  "name": "Invoice Parser API",
  "slug": "invoice-parser",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 300
    },
    "pay_per_call": {
      "parse": "$0.005",
      "extract-line-items": "$0.005",
      "classify": "$0.003",
      "execution-gate": "$0.001",
      "invoice-intelligence": "$0.010",
      "validate": "$0.003",
      "batch": "$0.040"
    }
  },
  "rate_limits": {
    "free": "300/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/parse",
      "description": "Parse invoice document"
    },
    {
      "method": "POST",
      "path": "/extract-line-items",
      "description": "Extract invoice line items"
    },
    {
      "method": "POST",
      "path": "/classify",
      "description": "Classify invoice type"
    },
    {
      "method": "POST",
      "path": "/execution-gate",
      "description": "Execution readiness check"
    },
    {
      "method": "POST",
      "path": "/invoice-intelligence",
      "description": "ONE-CALL full invoice intelligence",
      "x_one_call": true
    },
    {
      "method": "POST",
      "path": "/validate",
      "description": "Validate invoice fields"
    },
    {
      "method": "POST",
      "path": "/batch",
      "description": "Batch parse up to 20 invoices"
    }
  ],
  "execution_chain": {
    "previous": "email-parser",
    "next": "receipt-parser",
    "optional_next": []
  }
}