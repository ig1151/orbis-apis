{
  "openapi": "3.1.0",
  "info": {
    "title": "Contract Clause API",
    "version": "2.0.0",
    "description": "Extract, classify, compare, and risk-assess legal clauses from contracts for legal automation and compliance agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 200
      },
      "pay_per_call": {
        "extract": "$0.008",
        "classify": "$0.005",
        "compare": "$0.008",
        "execution-gate": "$0.001",
        "contract-intelligence": "$0.015",
        "risk-assess": "$0.008",
        "batch": "$0.060"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/contract-clause"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/extract": {
      "post": {
        "operationId": "extractClauses",
        "summary": "Extract clauses from contract document",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  },
                  "clause_types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/classify": {
      "post": {
        "operationId": "classifyClauses",
        "summary": "Classify clause types \u2014 indemnity, liability, IP, termination",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clauses": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "clauses"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/compare": {
      "post": {
        "operationId": "compareClauses",
        "summary": "Compare clauses across two contract documents",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_a": {
                    "type": "string"
                  },
                  "document_b": {
                    "type": "string"
                  }
                },
                "required": [
                  "document_a",
                  "document_b"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/contract-intelligence": {
      "post": {
        "operationId": "contractIntelligence",
        "summary": "ONE-CALL: extract + classify + risk score + red flags + recommendations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/risk-assess": {
      "post": {
        "operationId": "riskAssess",
        "summary": "Risk-assess contract clauses for legal exposure",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  },
                  "jurisdiction": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchAnalyze",
        "summary": "Batch analyze up to 10 contracts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "documents": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 10
                  }
                },
                "required": [
                  "documents"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}