{
  "openapi": "3.1.0",
  "info": {
    "title": "Slug Generator API",
    "version": "1.0.0",
    "description": "Generate SEO-friendly URL slugs from titles and text. Handle transliteration, stop-word removal, deduplication, and batch generation.",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 2000
      },
      "pay_per_call": {
        "generate": "$0.001",
        "validate": "$0.001",
        "batch": "$0.005",
        "execution-gate": "$0.001",
        "slug-intelligence": "$0.003"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/slug-generator"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/generate": {
      "post": {
        "operationId": "generate",
        "summary": "Generate a URL slug from a title or phrase",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generate a URL slug from a title or phrase"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/validate": {
      "post": {
        "operationId": "validate",
        "summary": "Validate and clean an existing slug",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validate and clean an existing slug"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batch",
        "summary": "Batch generate slugs for up to 50 titles",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch generate slugs for up to 50 titles"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gate result"
          }
        }
      }
    },
    "/slug-intelligence": {
      "post": {
        "operationId": "slugIntelligence",
        "summary": "ONE-CALL: generate + validate + SEO score + alternatives",
        "x-one-call": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full intelligence"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}