{
  "openapi": "3.1.0",
  "info": {
    "title": "Table Extraction API",
    "version": "2.0.0",
    "description": "Extract, convert, merge, and clean tabular data from documents and images for data pipeline and ETL automation agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 300
      },
      "pay_per_call": {
        "extract": "$0.005",
        "convert": "$0.003",
        "merge": "$0.005",
        "execution-gate": "$0.001",
        "table-intelligence": "$0.010",
        "clean": "$0.003",
        "batch": "$0.040"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/table-extraction"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/extract": {
      "post": {
        "operationId": "extractTable",
        "summary": "Extract tables from document or image",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "page_range": {
                    "type": "string"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "csv",
                      "markdown"
                    ]
                  }
                },
                "required": [
                  "document_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/convert": {
      "post": {
        "operationId": "convertTable",
        "summary": "Convert table to structured format",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "table_data": {
                    "type": "string"
                  },
                  "from_format": {
                    "type": "string"
                  },
                  "to_format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "csv",
                      "xlsx",
                      "markdown"
                    ]
                  }
                },
                "required": [
                  "table_data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/merge": {
      "post": {
        "operationId": "mergeTables",
        "summary": "Merge multiple tables by key column",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tables": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "merge_key": {
                    "type": "string"
                  }
                },
                "required": [
                  "tables"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/table-intelligence": {
      "post": {
        "operationId": "tableIntelligence",
        "summary": "ONE-CALL: extract + clean + convert + schema inference",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/clean": {
      "post": {
        "operationId": "cleanTable",
        "summary": "Clean and normalize table data \u2014 fix headers, types, nulls",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "table_data": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchExtract",
        "summary": "Batch extract from up to 10 documents",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "documents": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 10
                  }
                },
                "required": [
                  "documents"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}