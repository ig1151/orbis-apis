{
  "name": "Robots.txt Parser API",
  "slug": "robots-txt-parser",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": { "data_stored": false, "retention": "none" },
  "pricing": {
    "free_tier": { "requests_per_day": 500 },
    "pay_per_call": { "parse": "$0.002", "execution-gate": "$0.001", "robots-intelligence": "$0.006" }
  },
  "rate_limits": { "free": "500/day", "paid": "50000/day", "enterprise": "500000/day" },
  "endpoints": ["parse", "validate", "execution-gate", "robots-intelligence"],
  "execution_chain": { "recommended_start": "/robots-intelligence", "fallback": "/parse", "batch_endpoint": "/parse" }
}
