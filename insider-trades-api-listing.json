{
  "name": "Insider Trades API",
  "slug": "insider-trades",
  "version": "1.0.0",
  "description": "Look up SEC insider trading filings, extract buy/sell signals, summarize insider activity and detect trend patterns for investment research agents",
  "category": "Finance / Market",
  "tags": ["insider-trading", "sec-filings", "stocks", "investment", "compliance"],
  "pricing": {
