  },
  "endpoints": ["/lookup", "/signals", "/summary", "/execution-gate", "/insider-intelligence", "/trend", "/batch"],
  "one_call_endpoint": "/insider-intelligence",
  "base_url": "https://orbis-apis.onrender.com/insider-trades",
  "openapi_url": "https://orbis-apis.onrender.com/insider-trades/openapi.json",
  "auth": { "type": "apiKey", "header": "X-API-Key" },
  "grade": "A+",
  "mcp_compatible": true,
  "agent_callable": true,
  "privacy": { "data_stored": false, "retention": "none" }
}
