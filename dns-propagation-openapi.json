{
  "openapi": "3.1.0",
  "info": {
    "title": "DNS Propagation API",
    "version": "1.0.0",
    "description": "Check DNS propagation status across global nameservers, track record updates, and verify propagation completion after DNS changes.",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 500
      },
      "pay_per_call": {
        "check": "$0.002",
        "status": "$0.002",
        "trace": "$0.003",
        "execution-gate": "$0.001",
        "propagation-intelligence": "$0.006"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/dns-propagation"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/check": {
      "post": {
        "operationId": "check",
        "summary": "Check DNS propagation status across global nodes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Check DNS propagation status across global nodes"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/status": {
      "post": {
        "operationId": "status",
        "summary": "Get propagation percentage and regional breakdown",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Get propagation percentage and regional breakdown"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/trace": {
      "post": {
        "operationId": "trace",
        "summary": "Trace DNS resolution path",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trace DNS resolution path"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gate result"
          }
        }
      }
    },
    "/propagation-intelligence": {
      "post": {
        "operationId": "propagationIntelligence",
        "summary": "ONE-CALL: propagation check + status + resolution trace",
        "x-one-call": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full intelligence"
          },
          "400": {
            "description": "Missing input"
          },
          "500": {
            "description": "Failed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}