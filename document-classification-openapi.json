{
  "openapi": "3.1.0",
  "info": {
    "title": "Document Classification API",
    "version": "2.0.0",
    "description": "Classify, segment, and extract metadata from documents for intelligent routing and document management automation agents",
    "x-agent-callable": true,
    "x-mcp-compatible": true,
    "x-pricing": {
      "free_tier": {
        "requests_per_day": 500
      },
      "pay_per_call": {
        "classify": "$0.003",
        "extract-metadata": "$0.003",
        "compare": "$0.005",
        "execution-gate": "$0.001",
        "document-intelligence": "$0.008",
        "segment": "$0.005",
        "batch": "$0.025"
      }
    }
  },
  "servers": [
    {
      "url": "https://orbis-apis.onrender.com/document-classification"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/classify": {
      "post": {
        "operationId": "classifyDocument",
        "summary": "Classify document type \u2014 invoice, contract, report, email, etc.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/extract-metadata": {
      "post": {
        "operationId": "extractMetadata",
        "summary": "Extract document metadata \u2014 author, date, language, length",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/compare": {
      "post": {
        "operationId": "compareDocuments",
        "summary": "Compare two documents for similarity and differences",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_a": {
                    "type": "string"
                  },
                  "document_b": {
                    "type": "string"
                  }
                },
                "required": [
                  "document_a",
                  "document_b"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/execution-gate": {
      "post": {
        "operationId": "executionGate",
        "summary": "Execution readiness check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/document-intelligence": {
      "post": {
        "operationId": "documentIntelligence",
        "summary": "ONE-CALL: classify + metadata + language + routing recommendation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-one-call": true
      }
    },
    "/segment": {
      "post": {
        "operationId": "segmentDocument",
        "summary": "Segment document into logical sections",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "operationId": "batchClassify",
        "summary": "Batch classify up to 20 documents",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "documents": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 20
                  }
                },
                "required": [
                  "documents"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}