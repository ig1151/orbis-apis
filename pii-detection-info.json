{
  "name": "PII Detection API",
  "slug": "pii-detection",
  "version": "1.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 100,
      "requests_per_month": 3000
    },
    "pay_per_call": {
      "detect": "$0.003",
      "redact": "$0.004",
      "classify": "$0.003",
      "execution_gate": "$0.001",
      "analyze": "$0.007"
    },
    "high_volume": {
      "detect": "$0.0015",
      "redact": "$0.002",
      "analyze": "$0.0035"
    }
  },
  "rate_limits": {
    "free": "100/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/detect",
      "description": "Detect PII"
    },
    {
      "method": "POST",
      "path": "/redact",
      "description": "Redact PII"
    },
    {
      "method": "POST",
      "path": "/classify",
      "description": "Classify PII types"
    },
    {
      "method": "POST",
      "path": "/execution-gate",
      "description": "Execution readiness check"
    },
    {
      "method": "POST",
      "path": "/analyze",
      "description": "ONE-CALL detect + redact + classify",
      "x_one_call": true
    }
  ],
  "execution_chain": {
    "previous": "content-moderation",
    "next": "email-parser",
    "optional_next": []
  }
}