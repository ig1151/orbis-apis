{
  "name": "HTML to Markdown API",
  "slug": "html-to-markdown",
  "version": "1.0.0",
  "description": "Convert HTML to clean Markdown, remove boilerplate, extract structured content and simplify for LLM ingestion pipelines",
  "category": "Web / Search / Scraping",
  "tags": ["html", "markdown", "conversion", "scraping", "content-extraction"],
  "pricing": {
    "free_tier": { "requests_per_day": 500 },
    "pay_per_call": { "convert": "$0.002", "clean": "$0.002", "extract": "$0.003", "execution-gate": "$0.001", "html-intelligence": "$0.006", "simplify": "$0.002", "batch": "$0.015" }
  },
  "endpoints": ["/convert", "/clean", "/extract", "/execution-gate", "/html-intelligence", "/simplify", "/batch"],
  "one_call_endpoint": "/html-intelligence",
  "base_url": "https://orbis-apis.onrender.com/html-to-markdown",
  "openapi_url": "https://orbis-apis.onrender.com/html-to-markdown/openapi.json",
  "auth": { "type": "apiKey", "header": "X-API-Key" },
  "grade": "A+",
  "mcp_compatible": true,
  "agent_callable": true,
  "privacy": { "data_stored": false, "retention": "none" }
}
