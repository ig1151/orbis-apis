{
  "name": "FAQ Generator API",
  "slug": "faq-generator",
  "version": "2.0.0",
  "grade": "A+",
  "mcp_compatible": true,
  "privacy": {
    "data_stored": false,
    "retention": "none"
  },
  "pricing": {
    "free_tier": {
      "requests_per_day": 500
    },
    "pay_per_call": {
      "generate": "$0.002",
      "expand": "$0.002",
      "execution-gate": "$0.001",
      "faq-intelligence": "$0.006"
    }
  },
  "rate_limits": {
    "free": "500/day",
    "paid": "50000/day",
    "enterprise": "500000/day"
  },
  "endpoints": [
    "generate",
    "expand",
    "execution-gate",
    "faq-intelligence"
  ],
  "execution_chain": {
    "recommended_start": "/faq-intelligence",
    "fallback": "/generate",
    "batch_endpoint": "/generate"
  }
}
